---
layout: layouts/base.njk
---
<article class="post">
  <header>
    {% set t = topic | topicInfo %}
    <p class="kicker"><a href="/topics/{{ t.slug }}/">{{ t.name }}</a>{% if series %} · {{ series }}{% endif %}</p>
    {% if tags and tags.length %}<p class="tags">{% for tag in tags %}<span>{{ tag }}</span>{% endfor %}</p>{% endif %}
    <h1>{{ title }}</h1>
    {% if description %}<p class="dek">{{ description }}</p>{% endif %}
    <p class="meta">{% if author %}{{ author }} · {% endif %}<time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time> · {{ content | readingTime }}</p>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  <footer class="post-foot">
    <a href="/">← All posts</a>
  </footer>
</article>

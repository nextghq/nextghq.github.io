---
layout: layouts/base.njk
---
<section class="intro">
  <h1>Open, programmable, secure NextG wireless.</h1>
  <p>{{ site.description }}</p>
</section>

<ol class="post-list">
{% for post in collections.posts %}
  <li>
    <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    {% set blurb = post.data.description or post.data.excerpt %}{% if blurb %}<p>{{ blurb }}</p>{% endif %}
  </li>
{% endfor %}
</ol>
